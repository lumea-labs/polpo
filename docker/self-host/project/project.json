{
  "schemaVersion": 2,
  "project": "self-host-e2e",
  "settings": {
    "storage": "postgres",
    "orchestratorModel": "mock/e2e-model",
    "workDir": ".",
    "logLevel": "normal"
  },
  "providers": {
    "mock": {
      "baseUrl": "http://mock-llm:4010/v1",
      "api": "openai-completions",
      "models": [
        {
          "id": "e2e-model",
          "name": "E2E deterministic model",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 32000,
          "maxTokens": 2048,
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
  }
}
