# Generate both secrets before exposing this stack to a network.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POLPO_API_KEY=replace-with-a-long-random-api-key

# Vercel AI Gateway example. Change POLPO_MODEL and provider credentials
# together when using another configured provider.
POLPO_MODEL=anthropic/claude-sonnet-4.5
AI_GATEWAY_API_KEY=

POSTGRES_DB=polpo
POSTGRES_USER=polpo
POLPO_DASHBOARD_PORT=3000
