{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "//#build:root": {
      "dependsOn": [
        "@polpo-ai/node#build"
      ],
      "inputs": [
        "src/**",
        "tsconfig.json"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
