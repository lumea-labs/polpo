{
  "name": "polpo-ai",
  "version": "0.15.106",
  "description": "The open backend for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist/",
    "!dist/__tests__/",
    "playbooks/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "turbo run build build:root",
    "dev": "tsc --watch",
    "start": "node packages/cli/dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:self-host": "node docker/self-host/e2e.mjs",
    "check:dashboard-parity": "node scripts/check-dashboard-v2-parity.mjs",
    "typecheck": "turbo run build && tsc --noEmit",
    "clean": "rm -rf dist",
    "build:root": "tsc"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "coding-agents",
    "multi-agent",
    "baas",
    "runtime"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumea-labs/polpo.git"
  },
  "homepage": "https://polpo.sh",
  "bugs": {
    "url": "https://github.com/lumea-labs/polpo/issues"
  },
  "author": "Lumea Labs",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@polpo-ai/node": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^7.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.21.0",
    "turbo": "^2.10.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
