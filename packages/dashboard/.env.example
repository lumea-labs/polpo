# ── @polpo-ai/dashboard — self-host config ──────────────────────────────────

# Base URL of your OSS Polpo server (the data plane).
NEXT_PUBLIC_API_URL=http://localhost:4000

# API root the server mounts under. The standalone OSS server serves at /api/v1.
# (The views' internal /v1 is normalized away, so set the full root here.) Change
# only if you mounted the server somewhere else.
NEXT_PUBLIC_POLPO_API_PREFIX=/api/v1

# API key for the local server (sk_...). Generate one on your server. Optional
# if the server runs without auth (local dev).
NEXT_PUBLIC_POLPO_API_KEY=
